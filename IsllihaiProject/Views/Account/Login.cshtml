@model ApplicationUserViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تسجيل الدخول";
    var returnUrl = ViewData["ReturnUrl"] ?? Context.Request.Query["returnUrl"].ToString();
}

<section>
    <div class="container">
        <div class="form-shell">
            <h3 class="display" style="text-align:center; margin-bottom:6px;">تسجيل الدخول</h3>
            <p style="text-align:center; color:var(--text-dim); font-size:14px; margin-bottom:24px;">أهلًا بيك تاني</p>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div asp-validation-summary="ModelOnly" class="field-error" style="margin-bottom:12px;"></div>

                <div class="field">
                    <label asp-for="Email">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" placeholder="name@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">كلمة المرور</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-amber btn-block">دخول</button>
            </form>

            <p style="text-align:center; margin-top:18px; color:var(--text-dim); font-size:13.5px;">
                معندكش حساب؟
                <a asp-controller="Account" asp-action="Register" style="color:var(--amber);">سجّل دلوقتي</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
