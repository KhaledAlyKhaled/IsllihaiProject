@model IEnumerable<BookingTechnicainViewModel>

@{
    ViewData["Title"] = "طلبات العمل";
    var tecId = ViewContext.RouteData.Values["id"] ?? 1;
}

<section>
    <div class="container">
        <h2 class="display" style="margin-bottom:24px;">طلبات العمل</h2>

        @if (Model.Any())
        {
            <div style="display:grid; gap:14px;">
                @foreach (var b in Model)
                {
                    <div class="ticket">
                        <div class="ticket-head">
                            <span class="code mono">#@b.Id · @b.customerName</span>
                            <partial name="_StatusBadge" model="b.Status" />
                        </div>
                        <div class="ticket-body">
                            <div class="ticket-row"><span>العنوان</span><span>@b.Address</span></div>
                            <div class="ticket-row"><span>الوصف</span><span>@b.Description</span></div>
                            <div class="ticket-row" style="border:none; padding-bottom:0;"><span>الموعد</span><span>@b.StartDate.ToString("d MMM yyyy")</span></div>
                        </div>
                        @if (b.Status == "Pending" || b.Status == "Accepted" || b.Status == "InProgress")
                        {
                            <div class="ticket-foot">
                                @if (b.Status == "Pending")
                                {
                                    <form asp-action="Accept" method="post" style="flex:1;">
                                        <input type="hidden" name="bookingid" value="@b.Id" />
                                        <input type="hidden" name="tecId" value="@tecId" />
                                        <button type="submit" class="btn btn-teal btn-sm" style="width:100%;">قبول</button>
                                    </form>
                                    <form asp-action="Reject" method="post" style="flex:1;">
                                        <input type="hidden" name="bookingid" value="@b.Id" />
                                        <input type="hidden" name="tecId" value="@tecId" />
                                        <button type="submit" class="btn btn-ghost btn-sm" style="width:100%;">رفض</button>
                                    </form>
                                }
                                @if (b.Status == "Accepted")
                                {
                                    <form asp-action="Start" method="post" style="flex:1;">
                                        <input type="hidden" name="bookingid" value="@b.Id" />
                                        <input type="hidden" name="tecId" value="@tecId" />
                                        <button type="submit" class="btn btn-amber btn-sm" style="width:100%;">بدء التنفيذ</button>
                                    </form>
                                }
                                @if (b.Status == "InProgress")
                                {
                                    <form asp-action="Complete" method="post" style="flex:1;">
                                        <input type="hidden" name="bookingid" value="@b.Id" />
                                        <input type="hidden" name="tecId" value="@tecId" />
                                        <button type="submit" class="btn btn-teal btn-sm" style="width:100%;">إنهاء الطلب</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state"><p>مفيش طلبات عمل دلوقتي</p></div>
        }
    </div>
</section>
