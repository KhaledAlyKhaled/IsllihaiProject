@model CaregoryCreatedViewModel

@{
    ViewData["Title"] = "تصنيف جديد";
    Layout = "_Layout";
}

<main class="admin-main">
    <div class="admin-topbar">
        <div>
            <h2>تصنيف جديد</h2>
            <p>أضف تصنيف خدمة جديد للمنصة</p>
        </div>
    </div>

    <div class="crud-form">
        <h3>بيانات التصنيف</h3>
        <p class="hint">فيه Property واحدة بس: Name.</p>

        <form asp-controller="AdminCategorey" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div class="field">
                <label asp-for="Name">اسم التصنيف</label>
                <input asp-for="Name" class="form-control" placeholder="مثال: نجارة">
                <span asp-validation-for="Name" class="field-error"></span>
                <div class="field-hint">لازم يكون فريد — مش مسموح بتكرار الاسم</div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-amber">حفظ التصنيف</button>
                <a asp-controller="AdminCategorey" asp-action="Index" class="btn btn-ghost">إلغاء</a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}