@model IEnumerable<BookingAdminViewModel>

@{
    ViewData["Title"] = "الطلبات";
    Layout = "_AdminLayout";
}

<main class="admin-main">
    <div class="admin-topbar">
        <div>
            <h2>كل الطلبات</h2>
            <p>@Model.Count() طلب — مراقبة بس، مش بتعديل الحالة (ده شغل الفني/العميل)</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="admin-table">
            <thead>
                <tr><th>#</th><th>العميل</th><th>الفني</th><th>التصنيف</th><th>الموعد</th><th>الحالة</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="mono">#@b.Id</td>
                        <td>@b.CustomerName</td>
                        <td>@(b.TechName ?? "—")</td>
                        <td>@b.CategoryName</td>
                        <td class="mono">@b.StartDate.ToString("d MMM, h:mm tt")</td>
                        <td><span class="status-pill">@b.Status</span></td>
                        <td><a asp-controller="AdminBooking" asp-action="Details" asp-route-id="@b.Id" class="icon-btn" title="التفاصيل">👁</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="ico">📋</div>
            <p>مفيش طلبات مسجلة لسه</p>
        </div>
    }
</main>