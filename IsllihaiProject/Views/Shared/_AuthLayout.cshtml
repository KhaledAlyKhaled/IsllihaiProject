@* Layout لصفحات Login و Register و AccessDenied: من غير Navbar خالص *@
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — إصلحلي</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="blueprint">

    <div class="container" style="padding-top:40px; text-align:center;">
        <div class="brand" style="justify-content:center;">
            <span class="mark"><span>ص</span></span> إصلحلي
        </div>
    </div>

    <div class="container" style="padding-top:20px; max-width:480px;">
        <partial name="_Alerts" />
    </div>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
