<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — لوحة الأدمن | إصلحلي</title>
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body class="blueprint">

    <header class="site">
        <div class="bar">
            <a asp-controller="Home" asp-action="Index" class="brand"><span class="mark"><span>ص</span></span> إصلحلي</a>
            <div class="header-actions">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ghost btn-sm">🏠 الموقع الرئيسي</a>
                <span class="mono" style="font-size:12.5px; color:var(--text-dim); margin-right:8px;">لوحة الأدمن</span>
            </div>
        </div>
    </header>

    <div class="admin-shell">
        <aside class="admin-nav">
            <div class="group-label mono">الإدارة</div>
            <a asp-controller="AdminCategorey" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ACategorey" ? "active" : "")">📁 التصنيفات</a>
            <a asp-controller="AdminTechnicain" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Technicain" ? "active" : "")">🛠 الفنيين</a>
            <a asp-controller="AdminBooking" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")">📋 الطلبات</a>
        </aside>

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>