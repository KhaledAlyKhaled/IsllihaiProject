<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — إصلحلي</title>
    <link rel="stylesheet" href="~/css/Site/style.css">
</head>
<body class="blueprint">

    <header class="site">
        <div class="bar">
            <a asp-controller="Home" asp-action="Index" class="brand"><span class="mark"><span>ص</span></span> إصلحلي</a>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">الرئيسية</a>
                <a asp-controller="CustomerCategorey" asp-action="Index">الأقسام</a>
                @* TODO: الأرقام (1) دي مؤقتة لحد الـ Identity، وبعدها بتتشال والروابط بتتحدد حسب الدور *@
                <a asp-controller="Booking" asp-action="MyBookings" asp-route-id="1">طلباتي</a>
                <a asp-controller="TechnicianJobs" asp-action="MyJobs" asp-route-id="1">طلبات الفني</a>
                <a asp-controller="AdminCategorey" asp-action="Index">لوحة الأدمن</a>
            </nav>
            <div class="header-actions">
                <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">دخول</a>
            </div>
        </div>
    </header>

    <div class="container" style="padding-top:20px;">
        <partial name="_Alerts" />
    </div>

    @RenderBody()

    <footer>
        <div class="container foot-grid">
            <span>© 2026 إصلحلي</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
